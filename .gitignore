# Local configuration and hidden tool folders
.*
!.gitignore

# Datasets and external data
dataset/raw/
dataset/preprocessed/
dataset/external/
*.parquet
*.csv.gz
*.zip
*.7z
*.tar
*.tar.gz

# Generated outputs
result/
reports/
outputs/
logs/

# Model and array artifacts
*.pth
*.pt
*.ckpt
*.onnx
*.npy
*.npz
*.pkl
*.joblib

# Python caches and environments
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.env
env/
venv/
.venv/
.conda/

# Notebook caches
.ipynb_checkpoints/

# Large document/reference binaries
literature_review/
manuscript/reference/
manuscript/figures/*
!manuscript/figures/reviewer_robustness.png
manuscript/template/
manuscript/template/*.pdf
manuscript/template/fig1.png
manuscript/*.pdf
manuscript/*.aux
manuscript/*.bbl
manuscript/*.blg
manuscript/*.log
manuscript/*.out
manuscript/*.synctex.gz

# Temporary scripts and local notes
guide/
notebook/
scripts/*.txt
src/report/
src/temp_*.py
src/*_OLD/

# OS files
.DS_Store
Thumbs.db
desktop.ini
